{
  "schemaVersion": 1,
  "id": "permutations",
  "subject": "dsa",
  "track": "backtracking",
  "title": "Permutations",
  "difficulty": "medium",
  "summary": "At each level choose one number not yet used. The choices form a decision tree whose every root-to-leaf path places all the numbers in some order, so the leaves are exactly the permutations.",
  "problem": "Return every possible ordering (permutation) of the distinct numbers [1, 2, 3].",
  "example": { "input": "[1, 2, 3]", "output": "6 permutations" },
  "steps": [
    {
      "caption": "Build a permutation by picking an unused number at each level. Every root-to-leaf path uses all three numbers once, giving one ordering.",
      "visual": {
        "type": "rtree",
        "root": {
          "value": "[]", "state": "active", "pointer": "go",
          "children": [
            { "value": "[1]", "edge": "1", "children": [ { "value": "[1,2]", "edge": "2", "children": [ { "value": "[1,2,3]", "edge": "3" } ] }, { "value": "[1,3]", "edge": "3", "children": [ { "value": "[1,3,2]", "edge": "2" } ] } ] },
            { "value": "[2]", "edge": "2", "children": [ { "value": "[2,1]", "edge": "1", "children": [ { "value": "[2,1,3]", "edge": "3" } ] }, { "value": "[2,3]", "edge": "3", "children": [ { "value": "[2,3,1]", "edge": "1" } ] } ] },
            { "value": "[3]", "edge": "3", "children": [ { "value": "[3,1]", "edge": "1", "children": [ { "value": "[3,1,2]", "edge": "2" } ] }, { "value": "[3,2]", "edge": "2", "children": [ { "value": "[3,2,1]", "edge": "1" } ] } ] }
          ]
        }
      }
    },
    {
      "caption": "Choose 1, then 2, then the only number left, 3. The path spells out the permutation [1, 2, 3].",
      "visual": {
        "type": "rtree",
        "root": {
          "value": "[]", "state": "active",
          "children": [
            { "value": "[1]", "edge": "1", "state": "active", "children": [ { "value": "[1,2]", "edge": "2", "state": "active", "children": [ { "value": "[1,2,3]", "edge": "3", "state": "done" } ] }, { "value": "[1,3]", "edge": "3", "children": [ { "value": "[1,3,2]", "edge": "2" } ] } ] },
            { "value": "[2]", "edge": "2", "children": [ { "value": "[2,1]", "edge": "1", "children": [ { "value": "[2,1,3]", "edge": "3" } ] }, { "value": "[2,3]", "edge": "3", "children": [ { "value": "[2,3,1]", "edge": "1" } ] } ] },
            { "value": "[3]", "edge": "3", "children": [ { "value": "[3,1]", "edge": "1", "children": [ { "value": "[3,1,2]", "edge": "2" } ] }, { "value": "[3,2]", "edge": "2", "children": [ { "value": "[3,2,1]", "edge": "1" } ] } ] }
          ]
        }
      }
    },
    {
      "caption": "Backtrack and swap the last two choices: 1, then 3, then 2 gives [1, 3, 2]. The '1 first' branch yields 2 permutations.",
      "visual": {
        "type": "rtree",
        "root": {
          "value": "[]",
          "children": [
            { "value": "[1]", "edge": "1", "state": "active", "children": [ { "value": "[1,2]", "edge": "2", "children": [ { "value": "[1,2,3]", "edge": "3", "state": "done" } ] }, { "value": "[1,3]", "edge": "3", "children": [ { "value": "[1,3,2]", "edge": "2", "state": "done" } ] } ] },
            { "value": "[2]", "edge": "2", "children": [ { "value": "[2,1]", "edge": "1", "children": [ { "value": "[2,1,3]", "edge": "3" } ] }, { "value": "[2,3]", "edge": "3", "children": [ { "value": "[2,3,1]", "edge": "1" } ] } ] },
            { "value": "[3]", "edge": "3", "children": [ { "value": "[3,1]", "edge": "1", "children": [ { "value": "[3,1,2]", "edge": "2" } ] }, { "value": "[3,2]", "edge": "2", "children": [ { "value": "[3,2,1]", "edge": "1" } ] } ] }
          ]
        }
      }
    },
    {
      "caption": "Starting with 2 gives [2, 1, 3] and [2, 3, 1]; starting with 3 gives [3, 1, 2] and [3, 2, 1].",
      "visual": {
        "type": "rtree",
        "root": {
          "value": "[]",
          "children": [
            { "value": "[1]", "edge": "1", "children": [ { "value": "[1,2]", "edge": "2", "children": [ { "value": "[1,2,3]", "edge": "3", "state": "done" } ] }, { "value": "[1,3]", "edge": "3", "children": [ { "value": "[1,3,2]", "edge": "2", "state": "done" } ] } ] },
            { "value": "[2]", "edge": "2", "state": "active", "children": [ { "value": "[2,1]", "edge": "1", "children": [ { "value": "[2,1,3]", "edge": "3", "state": "done" } ] }, { "value": "[2,3]", "edge": "3", "children": [ { "value": "[2,3,1]", "edge": "1", "state": "done" } ] } ] },
            { "value": "[3]", "edge": "3", "state": "active", "children": [ { "value": "[3,1]", "edge": "1", "children": [ { "value": "[3,1,2]", "edge": "2", "state": "done" } ] }, { "value": "[3,2]", "edge": "2", "children": [ { "value": "[3,2,1]", "edge": "1", "state": "done" } ] } ] }
          ]
        }
      }
    },
    {
      "caption": "Six leaves, six orderings — that is 3! = 6 permutations of [1, 2, 3].",
      "visual": {
        "type": "rtree",
        "root": {
          "value": "[]", "state": "done",
          "children": [
            { "value": "[1]", "edge": "1", "state": "done", "children": [ { "value": "[1,2]", "edge": "2", "children": [ { "value": "[1,2,3]", "edge": "3", "state": "done" } ] }, { "value": "[1,3]", "edge": "3", "children": [ { "value": "[1,3,2]", "edge": "2", "state": "done" } ] } ] },
            { "value": "[2]", "edge": "2", "state": "done", "children": [ { "value": "[2,1]", "edge": "1", "children": [ { "value": "[2,1,3]", "edge": "3", "state": "done" } ] }, { "value": "[2,3]", "edge": "3", "children": [ { "value": "[2,3,1]", "edge": "1", "state": "done" } ] } ] },
            { "value": "[3]", "edge": "3", "state": "done", "children": [ { "value": "[3,1]", "edge": "1", "children": [ { "value": "[3,1,2]", "edge": "2", "state": "done" } ] }, { "value": "[3,2]", "edge": "2", "children": [ { "value": "[3,2,1]", "edge": "1", "state": "done" } ] } ] }
          ]
        }
      }
    }
  ]
}
