{
  "schemaVersion": 1,
  "id": "diameter-of-binary-tree",
  "subject": "dsa",
  "track": "trees",
  "title": "Diameter of Binary Tree",
  "difficulty": "easy",
  "summary": "Compute each node's height bottom-up. The longest path bending through a node is its left height plus its right height; track the largest such sum.",
  "problem": "Return the diameter: the number of edges on the longest path between any two nodes (it need not pass through the root).",
  "example": { "input": "[1, 2, 3, 4, 5]", "output": "3" },
  "steps": [
    {
      "caption": "Diameter = the longest path (edges) between two nodes; it may skip the root. Key: the path bending through a node = its left height + right height.",
      "visual": {
        "type": "tree",
        "root": {
          "value": 1,
          "left": { "value": 2, "left": { "value": 4 }, "right": { "value": 5 } },
          "right": { "value": 3 }
        }
      }
    },
    {
      "caption": "Compute heights bottom-up. Leaves 4 and 5 each have height 1 — just themselves.",
      "visual": {
        "type": "tree",
        "root": {
          "value": 1,
          "left": { "value": 2, "left": { "value": 4, "state": "active", "pointer": "1" }, "right": { "value": 5, "state": "active", "pointer": "1" } },
          "right": { "value": 3 }
        }
      }
    },
    {
      "caption": "Leaf 3 also has height 1.",
      "visual": {
        "type": "tree",
        "root": {
          "value": 1,
          "left": { "value": 2, "left": { "value": 4, "state": "done", "pointer": "1" }, "right": { "value": 5, "state": "done", "pointer": "1" } },
          "right": { "value": 3, "state": "active", "pointer": "1" }
        }
      }
    },
    {
      "caption": "Node 2: height = 1 + max(1, 1) = 2. The path bending through it is left + right = 1 + 1 = 2 edges (4-2-5). Best diameter so far: 2.",
      "visual": {
        "type": "tree",
        "root": {
          "value": 1,
          "left": { "value": 2, "state": "active", "pointer": "2", "left": { "value": 4, "state": "compare", "pointer": "1" }, "right": { "value": 5, "state": "compare", "pointer": "1" } },
          "right": { "value": 3, "state": "done", "pointer": "1" }
        }
      }
    },
    {
      "caption": "Root 1: height = 1 + max(2, 1) = 3. Path through it = left 2 + right 1 = 3 edges (4-2-1-3). New best: 3.",
      "visual": {
        "type": "tree",
        "root": {
          "value": 1, "state": "active", "pointer": "3",
          "left": { "value": 2, "state": "compare", "pointer": "2", "left": { "value": 4, "state": "compare", "pointer": "1" }, "right": { "value": 5, "pointer": "1" } },
          "right": { "value": 3, "state": "compare", "pointer": "1" }
        }
      }
    },
    {
      "caption": "The longest path runs 4-2-1-3: three edges. Diameter = 3.",
      "visual": {
        "type": "tree",
        "root": {
          "value": 1, "state": "done",
          "left": { "value": 2, "state": "done", "left": { "value": 4, "state": "done" }, "right": { "value": 5 } },
          "right": { "value": 3, "state": "done" }
        }
      }
    }
  ]
}
