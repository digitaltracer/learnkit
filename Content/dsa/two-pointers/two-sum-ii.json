    },
    {
      "caption": "3 + 8 = 11. Too big again, so move R left.",
      "visual": { "type": "array", "cells": [1, 3, 4, 6, 8, 11], "pointers": [{ "label": "L", "index": 1 }, { "label": "R", "index": 4 }], "highlights": [{ "index": 1, "state": "compare" }, { "index": 4, "state": "compare" }] }
    },
    {
      "caption": "3 + 6 = 9. Too small, so move L right.",
      "visual": { "type": "array", "cells": [1, 3, 4, 6, 8, 11], "pointers": [{ "label": "L", "index": 1 }, { "label": "R", "index": 3 }], "highlights": [{ "index": 1, "state": "compare" }, { "index": 3, "state": "compare" }] }
