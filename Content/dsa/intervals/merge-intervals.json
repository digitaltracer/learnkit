{
  "schemaVersion": 1,
  "id": "merge-intervals",
  "subject": "dsa",
  "track": "intervals",
  "title": "Merge Intervals",
  "difficulty": "medium",
  "summary": "Sort by start, then sweep left to right. If the next interval starts at or before the current one's end, they overlap, so stretch the current end; otherwise close it off and start a new one.",
  "problem": "Merge all overlapping intervals and return the non-overlapping result.",
  "example": { "input": "[[1,3],[2,6],[8,10],[15,18]]", "output": "[[1,6],[8,10],[15,18]]" },
  "steps": [
    {
      "caption": "Merge every overlapping pair. First sort by start time so overlaps are always adjacent.",
      "visual": {
        "type": "intervals",
        "axisMin": 0, "axisMax": 18,
        "rows": [
          { "start": 1, "end": 3 }, { "start": 2, "end": 6 },
          { "start": 8, "end": 10 }, { "start": 15, "end": 18 }
        ]
      }
    },
    {
      "caption": "Compare 1-3 and 2-6. The next start, 2, is <= 3, so they overlap.",
      "visual": {
        "type": "intervals",
        "axisMin": 0, "axisMax": 18,
        "rows": [
          { "start": 1, "end": 3, "state": "compare" }, { "start": 2, "end": 6, "state": "compare" },
          { "start": 8, "end": 10 }, { "start": 15, "end": 18 }
        ]
      }
    },
    {
      "caption": "Merge them into 1-6 (keep the smaller start, the larger end). Next is 8-10: 8 > 6, no overlap, so close 1-6.",
      "visual": {
        "type": "intervals",
        "axisMin": 0, "axisMax": 18,
        "rows": [
          { "start": 1, "end": 6, "state": "done" }, { "start": 8, "end": 10, "state": "compare" },
          { "start": 15, "end": 18 }
        ]
      }
    },
    {
      "caption": "Compare 8-10 and 15-18: 15 > 10, no overlap. Keep 8-10 as is.",
      "visual": {
        "type": "intervals",
        "axisMin": 0, "axisMax": 18,
        "rows": [
          { "start": 1, "end": 6, "state": "done" }, { "start": 8, "end": 10, "state": "done" },
          { "start": 15, "end": 18, "state": "compare" }
        ]
      }
    },
    {
      "caption": "Nothing left to compare. The merged result is [1,6], [8,10], [15,18].",
      "visual": {
        "type": "intervals",
        "axisMin": 0, "axisMax": 18,
        "rows": [
          { "start": 1, "end": 6, "state": "done" }, { "start": 8, "end": 10, "state": "done" },
          { "start": 15, "end": 18, "state": "done" }
        ]
      }
    }
  ]
}
