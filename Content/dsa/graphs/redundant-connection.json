{
  "schemaVersion": 1,
  "id": "redundant-connection",
  "subject": "dsa",
  "track": "graphs",
  "title": "Redundant Connection",
  "difficulty": "medium",
  "summary": "A tree gained one extra edge, forming a single cycle. Find that extra edge.",
  "problem": "You start with a tree of n nodes and add one extra edge, creating exactly one cycle. Given the edges in the order they were added, return the edge that can be removed so the graph is a tree again. Return the last such edge.",
  "example": {
    "input": "edges = [[1,2],[1,3],[2,3]]",
    "output": "[2,3]"
  },
  "steps": [
    {
      "caption": "Goal: find the edge that closes a loop. Add edges in order and keep the one joining two already-connected nodes.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "1", "x": 0.5, "y": 0.15},
          {"id": "2", "x": 0.2, "y": 0.82},
          {"id": "3", "x": 0.8, "y": 0.82}
        ],
        "edges": [
          {"from": "1", "to": "2"},
          {"from": "1", "to": "3"},
          {"from": "2", "to": "3"}
        ]
      }
    },
    {
      "caption": "Add edge 1-2. It joins two separate nodes, so keep it.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "1", "x": 0.5, "y": 0.15, "state": "active"},
          {"id": "2", "x": 0.2, "y": 0.82, "state": "active"},
          {"id": "3", "x": 0.8, "y": 0.82}
        ],
        "edges": [
          {"from": "1", "to": "2", "state": "match"},
          {"from": "1", "to": "3"},
          {"from": "2", "to": "3"}
        ]
      }
    },
    {
      "caption": "Add edge 1-3. Node 3 was separate, so this also joins new parts. Keep it.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "1", "x": 0.5, "y": 0.15, "state": "done"},
          {"id": "2", "x": 0.2, "y": 0.82, "state": "done"},
          {"id": "3", "x": 0.8, "y": 0.82, "state": "active"}
        ],
        "edges": [
          {"from": "1", "to": "2", "state": "done"},
          {"from": "1", "to": "3", "state": "match"},
          {"from": "2", "to": "3"}
        ]
      }
    },
    {
      "caption": "Add edge 2-3. Nodes 2 and 3 are already connected through 1, so this closes a cycle and is redundant.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "1", "x": 0.5, "y": 0.15, "state": "done"},
          {"id": "2", "x": 0.2, "y": 0.82, "state": "done"},
          {"id": "3", "x": 0.8, "y": 0.82, "state": "done"}
        ],
        "edges": [
          {"from": "1", "to": "2", "state": "done"},
          {"from": "1", "to": "3", "state": "done"},
          {"from": "2", "to": "3", "state": "mismatch"}
        ]
      }
    },
    {
      "caption": "The redundant edge is [2,3]. Removing it leaves a valid tree.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "1", "x": 0.5, "y": 0.15, "state": "done"},
          {"id": "2", "x": 0.2, "y": 0.82, "state": "done"},
          {"id": "3", "x": 0.8, "y": 0.82, "state": "done"}
        ],
        "edges": [
          {"from": "1", "to": "2", "state": "done"},
          {"from": "1", "to": "3", "state": "done"},
          {"from": "2", "to": "3", "state": "mismatch"}
        ]
      }
    }
  ]
}
