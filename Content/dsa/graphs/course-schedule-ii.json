          {"from": "0", "to": "1", "directed": true, "state": "done"},
          {"from": "0", "to": "2", "directed": true, "state": "done"},
          {"from": "1", "to": "3", "directed": true, "state": "done"},
          {"from": "2", "to": "3", "directed": true, "state": "done"}
        ]
      }
