          {"id": "ATL", "x": 0.2, "y": 0.82},
          {"id": "SFO", "x": 0.8, "y": 0.82}
        ],
        "edges": [
          {"from": "JFK", "to": "ATL", "directed": true},
          {"from": "JFK", "to": "SFO", "directed": true},
          {"from": "ATL", "to": "JFK", "directed": true},
          {"from": "ATL", "to": "SFO", "directed": true},
          {"from": "SFO", "to": "ATL", "directed": true}
        ]
      }
    },
