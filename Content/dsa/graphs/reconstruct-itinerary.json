  "title": "Reconstruct Itinerary",
  "difficulty": "hard",
  "summary": "Use every flight ticket exactly once from JFK, building one itinerary with Hierholzer's algorithm.",
  "problem": "Given a list of airline tickets where each ticket is [from, to], reconstruct an itinerary that uses every ticket exactly once and starts at JFK. When there is more than one valid choice, take the airport that is alphabetically smaller first. The itinerary is an Eulerian path found with Hierholzer's algorithm.",
  "example": {
    "input": "[[\"JFK\",\"SFO\"],[\"JFK\",\"ATL\"],[\"SFO\",\"ATL\"],[\"ATL\",\"JFK\"],[\"ATL\",\"SFO\"]]",
    "output": "[\"JFK\",\"ATL\",\"JFK\",\"SFO\",\"ATL\",\"SFO\"]"
  },
  "steps": [
