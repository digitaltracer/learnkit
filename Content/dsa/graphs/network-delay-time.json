  "id": "network-delay-time",
  "subject": "dsa",
  "track": "graphs",
  "title": "Network Delay Time",
  "difficulty": "medium",
  "summary": "Find how long a signal takes to reach every node, using shortest paths from the source.",
  "problem": "A signal starts at node k and travels along directed edges with travel times. Return the time for all n nodes to receive it, which is the largest of the shortest-path distances. If any node is unreachable, return -1.",
  "example": {
    "input": "times = [[2,1,1],[2,3,1],[3,4,1]], n = 4, k = 2",
    "output": "2"
  },
  "steps": [
    {
      "caption": "Goal: a signal starts at node 2. The delay is the longest of the shortest times to reach every node.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "2", "x": 0.18, "y": 0.5},
          {"id": "1", "x": 0.55, "y": 0.2},
          {"id": "3", "x": 0.55, "y": 0.8},
          {"id": "4", "x": 0.9, "y": 0.8}
        ],
        "edges": [
          {"from": "2", "to": "1", "directed": true, "weight": 1},
          {"from": "2", "to": "3", "directed": true, "weight": 1},
          {"from": "3", "to": "4", "directed": true, "weight": 1}
        ]
      }
    },
    {
      "caption": "Start at node 2 with distance 0.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "2", "x": 0.18, "y": 0.5, "state": "active", "pointer": "0"},
          {"id": "1", "x": 0.55, "y": 0.2},
          {"id": "3", "x": 0.55, "y": 0.8},
          {"id": "4", "x": 0.9, "y": 0.8}
        ],
        "edges": [
          {"from": "2", "to": "1", "directed": true, "weight": 1},
          {"from": "2", "to": "3", "directed": true, "weight": 1},
          {"from": "3", "to": "4", "directed": true, "weight": 1}
        ]
      }
    },
    {
      "caption": "Relax the neighbors of 2. Nodes 1 and 3 each reach distance 1.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "2", "x": 0.18, "y": 0.5, "state": "done"},
          {"id": "1", "x": 0.55, "y": 0.2, "state": "match", "pointer": "1"},
          {"id": "3", "x": 0.55, "y": 0.8, "state": "match"},
          {"id": "4", "x": 0.9, "y": 0.8}
