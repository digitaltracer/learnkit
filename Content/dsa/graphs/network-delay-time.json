        "edges": [
          {"from": "2", "to": "1", "directed": true, "weight": 1, "state": "done"},
          {"from": "2", "to": "3", "directed": true, "weight": 1, "state": "done"},
          {"from": "3", "to": "4", "directed": true, "weight": 1}
        ]
      }
    },
    {
      "caption": "From node 3, reach node 4 at distance 2.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "2", "x": 0.18, "y": 0.5, "state": "done"},
          {"id": "1", "x": 0.55, "y": 0.2, "state": "done"},
          {"id": "3", "x": 0.55, "y": 0.8, "state": "done"},
          {"id": "4", "x": 0.9, "y": 0.8, "state": "active", "pointer": "2"}
        ],
        "edges": [
          {"from": "2", "to": "1", "directed": true, "weight": 1, "state": "done"},
          {"from": "2", "to": "3", "directed": true, "weight": 1, "state": "done"},
          {"from": "3", "to": "4", "directed": true, "weight": 1, "state": "done"}
