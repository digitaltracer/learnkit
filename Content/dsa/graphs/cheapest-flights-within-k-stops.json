          {"from": "0", "to": "1", "directed": true, "weight": 100, "state": "mismatch"},
          {"from": "1", "to": "2", "directed": true, "weight": 100, "state": "mismatch"},
          {"from": "2", "to": "3", "directed": true, "weight": 100, "state": "mismatch"},
          {"from": "0", "to": "2", "directed": true, "weight": 500}
        ]
      }
    },
    {
