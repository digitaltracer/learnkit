          {"from": "0", "to": "2", "directed": true, "weight": 500, "state": "active"}
        ]
      }
    },
    {
      "caption": "Then fly 2 to 3 at cost 100. The total is 500 plus 100, using just 1 stop.",
      "visual": {
        "type": "graph",
        "nodes": [
          {"id": "0", "x": 0.12, "y": 0.5, "state": "active"},
