          {"id": "1", "x": 0.45, "y": 0.18},
          {"id": "2", "x": 0.45, "y": 0.82},
          {"id": "3", "x": 0.88, "y": 0.5}
        ],
        "edges": [
          {"from": "0", "to": "1", "directed": true, "weight": 100},
          {"from": "1", "to": "2", "directed": true, "weight": 100},
          {"from": "2", "to": "3", "directed": true, "weight": 100},
          {"from": "0", "to": "2", "directed": true, "weight": 500}
        ]
      }
    },
    {
