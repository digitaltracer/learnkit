{
  "schemaVersion": 1,
  "id": "best-time-to-buy-and-sell-stock",
  "subject": "dsa",
  "track": "sliding-window",
  "title": "Best Time to Buy and Sell Stock",
  "difficulty": "easy",
  "summary": "Track the cheapest day seen so far as your buy point. At each later day the profit is today's price minus that minimum; keep the best you've seen.",
  "problem": "Given daily prices, buy on one day and sell on a later day to maximize profit. Return the best profit, or 0 if none is possible.",
  "example": { "input": "[7, 1, 5, 3, 6, 4]", "output": "5  (buy 1, sell 6)" },
  "steps": [
    {
      "caption": "Each bar is a day's price. Buy once, sell on a later day, and make the most profit.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4] }
    },
    {
      "caption": "B tracks the cheapest day so far; S scans forward looking to sell.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4], "pointers": [{ "label": "B", "index": 0 }, { "label": "S", "index": 1 }], "highlights": [{ "index": 0, "state": "compare" }, { "index": 1, "state": "compare" }] }
    },
    {
      "caption": "Day 1's price 1 is below B's 7. We'd rather buy at 1, so reset B to day 1.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4], "pointers": [{ "label": "B", "index": 0 }, { "label": "S", "index": 1 }], "highlights": [{ "index": 1, "state": "mismatch" }] }
    },
    {
      "caption": "B is now day 1 (price 1). Sell at day 2: profit 5 - 1 = 4. Best so far: 4.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4], "pointers": [{ "label": "B", "index": 1 }, { "label": "S", "index": 2 }], "highlights": [{ "index": 1, "state": "match" }, { "index": 2, "state": "match" }] }
    },
    {
      "caption": "Day 3: profit 3 - 1 = 2. Worse than 4, so keep 4.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4], "pointers": [{ "label": "B", "index": 1 }, { "label": "S", "index": 3 }], "highlights": [{ "index": 1, "state": "compare" }, { "index": 3, "state": "compare" }] }
    },
    {
      "caption": "Day 4: profit 6 - 1 = 5. New best: 5.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4], "pointers": [{ "label": "B", "index": 1 }, { "label": "S", "index": 4 }], "highlights": [{ "index": 1, "state": "match" }, { "index": 4, "state": "match" }] }
    },
    {
      "caption": "Day 5: profit 4 - 1 = 3. Best stays 5.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4], "pointers": [{ "label": "B", "index": 1 }, { "label": "S", "index": 5 }], "highlights": [{ "index": 1, "state": "compare" }, { "index": 5, "state": "compare" }] }
    },
    {
      "caption": "Best plan: buy day 1 at 1, sell day 4 at 6. Maximum profit = 5.",
      "visual": { "type": "array", "style": "bars", "cells": [7, 1, 5, 3, 6, 4], "highlights": [{ "index": 1, "state": "done" }, { "index": 4, "state": "done" }] }
    }
  ]
}
