        "highlights": [{ "row": 1, "col": 3, "state": "compare" }, { "row": 1, "col": 2, "state": "compare" }, { "row": 0, "col": 4, "state": "compare" }, { "row": 1, "col": 4, "state": "active" }]
      }
    },
    {
      "caption": "The last dp cell holds the answer: 12, by robbing houses 2, 9, and 1 (no two adjacent).",
      "visual": {
        "type": "grid",
        "rows": [[2, 7, 9, 3, 1], [2, 7, 11, 11, 12]],
