        "highlights": [{ "rows": [0, 0], "cols": [0, 4], "state": "compare" }]
      }
    },
    {
      "caption": "dp[0]: only house 0 is available, so the best is its value, 2.",
      "visual": {
        "type": "grid",
        "rows": [[2, 7, 9, 3, 1], [2, "?", "?", "?", "?"]],
        "highlights": [{ "row": 0, "col": 0, "state": "compare" }, { "row": 1, "col": 0, "state": "active" }]
      }
    },
    {
      "caption": "dp[1] = max(skip house 1 so dp[0]=2, rob it so 7) = 7.",
      "visual": {
        "type": "grid",
        "rows": [[2, 7, 9, 3, 1], [2, 7, "?", "?", "?"]],
        "highlights": [{ "row": 1, "col": 0, "state": "compare" }, { "row": 0, "col": 1, "state": "compare" }, { "row": 1, "col": 1, "state": "active" }]
      }
    },
    {
      "caption": "dp[2] = max(skip so dp[1]=7, rob so dp[0]+9 = 2+9 = 11) = 11.",
      "visual": {
        "type": "grid",
        "rows": [[2, 7, 9, 3, 1], [2, 7, 11, "?", "?"]],
        "highlights": [{ "row": 1, "col": 1, "state": "compare" }, { "row": 1, "col": 0, "state": "compare" }, { "row": 0, "col": 2, "state": "compare" }, { "row": 1, "col": 2, "state": "active" }]
      }
    },
    {
      "caption": "dp[3] = max(skip so dp[2]=11, rob so dp[1]+3 = 7+3 = 10) = 11.",
      "visual": {
        "type": "grid",
        "rows": [[2, 7, 9, 3, 1], [2, 7, 11, 11, "?"]],
