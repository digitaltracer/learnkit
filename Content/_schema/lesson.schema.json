{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LearnKit Lesson",
  "description": "One self-contained Lesson: an ordered sequence of snapshot Steps. Each Step's `visual` is one Primitive, chosen by its `type`: `array`, `grid`, `tree`, `list`, `graph`, `hashmap`, `intervals`, or `rtree`.",
  "type": "object",
  "required": ["schemaVersion", "id", "subject", "track", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "kebab-case, unique within the track, matches the filename" },
    "subject": { "type": "string", "enum": ["dsa"] },
    "track": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "summary": { "type": "string", "description": "One-sentence framing of the approach." },
    "problem": { "type": "string", "description": "Short statement of what the problem asks (one or two sentences)." },
    "example": {
      "type": "object",
      "required": ["input", "output"],
      "additionalProperties": false,
      "description": "One small concrete example shown atop the Lesson.",
      "properties": {
        "input": { "type": "string" },
        "output": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["caption", "visual"],
      "additionalProperties": false,
      "properties": {
        "caption": { "type": "string", "maxLength": 160 },
        "visual": {
          "description": "One Primitive's spec. Selected by `type`; `array` and `grid` have disjoint required fields, so exactly one branch matches.",
          "oneOf": [
            { "$ref": "#/$defs/arrayVisual" },
            { "$ref": "#/$defs/gridVisual" },
            { "$ref": "#/$defs/treeVisual" },
            { "$ref": "#/$defs/listVisual" },
            { "$ref": "#/$defs/graphVisual" },
            { "$ref": "#/$defs/hashmapVisual" },
            { "$ref": "#/$defs/intervalsVisual" },
            { "$ref": "#/$defs/rtreeVisual" }
          ]
        }
      }
    },
    "arrayVisual": {
      "type": "object",
      "required": ["type", "cells"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "array" },
        "style": {
          "type": "string",
          "enum": ["cells", "bars"],
          "description": "How to draw the array. 'cells' (default) draws boxed values — for indices, characters, sorted numbers. 'bars' draws vertical bars scaled to each cell's numeric value — for heights/magnitudes (e.g. Container With Most Water). 'bars' requires all cells to be numeric."
        },
        "cells": {
          "type": "array",
          "description": "Full state of the array at this Step. Keep identical across Steps unless the data itself changes.",
          "items": { "type": ["string", "number"] }
        },
        "pointers": {
          "type": "array",
          "description": "Named pointers sitting on cells. Moving an index between Steps is what the app animates.",
          "items": {
            "type": "object",
            "required": ["label", "index"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 3 },
              "index": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "highlights": {
          "type": "array",
          "description": "Per-cell or per-range color states. Use `index` for one cell or `range` [start,end] inclusive.",
          "items": {
            "type": "object",
            "required": ["state"],
            "additionalProperties": false,
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
              "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] }
            }
          }
        }
      }
    },
    "gridVisual": {
      "type": "object",
      "required": ["type", "rows"],
      "additionalProperties": false,
      "description": "A 2-D matrix of cells — for matrices (rotate, spiral, search) and DP tables.",
      "properties": {
        "type": { "const": "grid" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "description": "Rows of cells, top to bottom. Every row must have the same length. Full state of the matrix at this Step; keep identical across Steps unless the data itself changes.",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": ["string", "number"] }
          }
        },
        "pointers": {
          "type": "array",
          "description": "Named pointers sitting on one cell each. Moving a pointer between Steps is what the app animates.",
          "items": {
            "type": "object",
            "required": ["label", "row", "col"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 3 },
              "row": { "type": "integer", "minimum": 0 },
              "col": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "highlights": {
          "type": "array",
          "description": "Per-cell or per-region color states. Use `row`+`col` for one cell, or `rows` [r0,r1] + `cols` [c0,c1] (both inclusive) for a rectangle.",
          "items": {
            "type": "object",
            "required": ["state"],
            "additionalProperties": false,
            "properties": {
              "row": { "type": "integer", "minimum": 0 },
              "col": { "type": "integer", "minimum": 0 },
              "rows": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
              "cols": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
              "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] }
            }
          }
        }
      }
    },
    "treeVisual": {
      "type": "object",
      "required": ["type", "root"],
      "additionalProperties": false,
      "description": "A binary tree. Each node carries its own optional highlight `state` and `pointer` label; the whole tree is the full state at this Step.",
      "properties": {
        "type": { "const": "tree" },
        "root": { "$ref": "#/$defs/treeNode" }
      }
    },
    "treeNode": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "description": "One node. Omit `left`/`right` for a missing child.",
      "properties": {
        "value": { "type": ["string", "number"] },
        "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] },
        "pointer": { "type": "string", "maxLength": 3, "description": "A short label drawn above this node." },
        "left": { "$ref": "#/$defs/treeNode" },
        "right": { "$ref": "#/$defs/treeNode" }
      }
    },
    "listVisual": {
      "type": "object",
      "required": ["type", "nodes"],
      "additionalProperties": false,
      "description": "A linked list: values in fixed left-to-right positions, joined by directed `next` links.",
      "properties": {
        "type": { "const": "list" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "description": "Node values in fixed left-to-right order. Full state at this Step.",
          "items": { "type": ["string", "number"] }
        },
        "links": {
          "type": "array",
          "description": "Directed next-pointers as [from, to] node indices. Omit for a simple forward chain (0->1->2->…). Re-pointing links between Steps is what animates a rewire/reversal.",
          "items": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }
        },
        "pointers": {
          "type": "array",
          "description": "Named pointers sitting on nodes (e.g. prv, cur).",
          "items": {
            "type": "object",
            "required": ["label", "index"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 3 },
              "index": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "highlights": {
          "type": "array",
          "description": "Per-node or per-range color states. Use `index` for one node or `range` [start,end] inclusive.",
          "items": {
            "type": "object",
            "required": ["state"],
            "additionalProperties": false,
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
              "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] }
            }
          }
        }
      }
    },
    "graphVisual": {
      "type": "object",
      "required": ["type", "nodes"],
      "additionalProperties": false,
      "description": "A general graph. Nodes carry explicit normalized positions (x,y in 0..1). Edges reference node ids and may be directed and/or weighted.",
      "properties": {
        "type": { "const": "graph" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "value": { "type": ["string", "number"], "description": "Drawn inside the node; defaults to the id." },
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] },
              "pointer": { "type": "string", "maxLength": 3 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "directed": { "type": "boolean" },
              "weight": { "type": ["string", "number"] },
              "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] }
            }
          }
        }
      }
    },
    "hashmapVisual": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "A key -> value map (or set). An optional `probe` shows a lookup and whether it hit.",
      "properties": {
        "type": { "const": "hashmap" },
        "entries": {
          "type": "array",
          "description": "Rows in insertion order. May be empty (an empty map).",
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": ["string", "number"] },
              "value": { "type": ["string", "number"] },
              "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] }
            }
          }
        },
        "probe": {
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "description": "A lookup in progress. `found` colors it as a hit or miss.",
          "properties": {
            "key": { "type": ["string", "number"] },
            "found": { "type": "boolean" }
          }
        }
      }
    },
    "intervalsVisual": {
      "type": "object",
      "required": ["type", "rows"],
      "additionalProperties": false,
      "description": "Intervals as horizontal bars on a shared time axis, one per row.",
      "properties": {
        "type": { "const": "intervals" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "number" },
              "end": { "type": "number" },
              "label": { "type": "string" },
              "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] }
            }
          }
        },
        "axisMin": { "type": "number", "description": "Axis left bound; defaults to min(0, smallest start)." },
        "axisMax": { "type": "number", "description": "Axis right bound; defaults to the largest end." }
      }
    },
    "rtreeVisual": {
      "type": "object",
      "required": ["type", "root"],
      "additionalProperties": false,
      "description": "An n-ary decision tree for backtracking. Each node is a partial state; the `edge` label is the choice that reached it.",
      "properties": {
        "type": { "const": "rtree" },
        "root": { "$ref": "#/$defs/rnode" }
      }
    },
    "rnode": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number"] },
        "edge": { "type": "string", "description": "Label on the edge from this node's parent (the choice taken)." },
        "state": { "type": "string", "enum": ["compare", "match", "mismatch", "done", "active"] },
        "pointer": { "type": "string", "maxLength": 3 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/rnode" } }
      }
    }
  }
}
